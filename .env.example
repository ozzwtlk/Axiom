# Server (Raspberry Pi) settings for docker compose. Copy to .env and fill in.
# Shared secret between the server and your computing machines (≥ 16 characters): `./axiom new-token`
AXIOM_TOKEN=
# Port on the Pi: open http://<pi-address>:8080
AXIOM_PORT=8080
# Where the books, database and cached images live on the Pi (an SSD is better than the SD card)
AXIOM_DATA=./server-data
